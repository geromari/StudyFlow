# =================================================================
# StudyFlow — Environment Configuration
# =================================================================

# Telegram Bot
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ_01234567

# Database (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://studyflow_user:studyflow_password@postgres:5432/studyflow_db
# For local SQLite development/testing without docker:
# DATABASE_URL=sqlite+aiosqlite:///studyflow.db

# Redis Cache & FSM
REDIS_URL=redis://redis:6379/0
# For local redis without docker:
# REDIS_URL=redis://localhost:6379/0

# AI Provider (OpenAI-compatible: OpenAI, DeepSeek, Groq, OpenRouter, LocalAI)
AI_API_KEY=sk-your-openai-or-compatible-api-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_TOKENS=1000
AI_RATE_LIMIT_PER_MINUTE=10

# Administrator Telegram IDs (comma-separated integers)
ADMIN_IDS=123456789,987654321

# General Settings
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
DEFAULT_TIMEZONE=UTC
MAX_PDF_SIZE_MB=10
